# Supabase接続設定
# supabase start で起動後、supabase status で確認できます
NEXT_PUBLIC_SUPABASE_URL=http://localhost:54321
NEXT_PUBLIC_SUPABASE_ANON_KEY=your-local-anon-key-here

# 管理者CSVインポートAPIルート用（サーバーサイドのみ。ブラウザには露出しない）
# supabase status の "service_role key" を設定してください
SUPABASE_SERVICE_ROLE_KEY=your-local-service-role-key-here

# 本番環境（Supabase hosted）の場合
# NEXT_PUBLIC_SUPABASE_URL=https://xxxxxxxxxxxx.supabase.co
# NEXT_PUBLIC_SUPABASE_ANON_KEY=your-anon-key-here
# SUPABASE_SERVICE_ROLE_KEY=your-service-role-key-here
